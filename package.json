{
  "name": "@rexymayderio/god-forbid-devtools",
  "version": "0.1.0",
  "private": false,
  "description": "Tree-shakable, browser-only anti-tamper toolkit: DevTools detector + context-menu guard + keyboard shortcut guard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "tsup"
  },
  "keywords": [
    "devtools",
    "devtools-detect",
    "context-menu",
    "anti-tamper",
    "nextjs",
    "static-export",
    "keyboard-guard",
    "source-map"
  ],
  "author": "Rexy Mayderio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "happy-dom": "^14.12.3",
    "prettier": "^3.3.3",
    "tsup": "^8.1.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {}
}
